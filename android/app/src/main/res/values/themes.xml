<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        PlugTalk draws its own chrome; the platform theme only provides the
        dark background and the correct status bar behaviour.
    -->
    <style name="Theme.PlugTalk" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0B0E11</item>
        <item name="android:statusBarColor">#FF101418</item>
        <item name="android:navigationBarColor">#FF101418</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
